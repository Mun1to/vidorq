# Secrets - NEVER commit keys
.env
.env.*
# froede's local secret: the browser extension writes to source files with it.
# Listed before the file exists, which is when a guard is worth anything.
.froede-token
*.key

# Dependencies
node_modules/
venv/
.venv/
__pycache__/
*.pyc

# Build output
dist/
build/
out/

# Video working files (heavy, never in git)
*.mp4
*.mov
*.mkv
*.wav
*.mp3
edit/
renders/
footage/

# AI models (downloaded on first use). The face detector is the exception:
# 227 KB, its own MIT licence, and bundling it is what lets a vertical crop
# aim at a face with the network unplugged.
models/
!skill/models/

# OS / editor noise
.DS_Store
Thumbs.db
*.log

